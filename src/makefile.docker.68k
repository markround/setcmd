CC=vc
CFLAGS=-lamiga -lauto +aos68k -I/opt/sdk/NDK_3.9/Include/include_h -Iinclude
OBJS=main.o utility.o usage.o init_os3.o list_os3.o add_cmd.o add_version.o delete_version.o delete_cmd.o set_version.o show_os3.o

all: setcmd stub

setcmd: $(OBJS)
	$(CC) -o setcmd $(OBJS) $(CFLAGS)

stub: stub.o utility.o
	$(CC) $(CFLAGS) -o stub stub.o utility.o -Iinclude
	
%.o : %.c
	$(CC) -c -o $@ $< $(CFLAGS) 

clean:
	rm *.o setcmd stub

debug: CFLAGS += -DDEBUG
debug: setcmd
debug: stub
