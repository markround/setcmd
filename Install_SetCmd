; $VER: Installation script for SetCmd
; vim: set syntax=lisp ts=2 expandtab:

(set @app-name "SetCmd")
(set #setcmd-version "2.0.0")

;  Version checks
(if (< (/ (getversion) 65536) 46)
  (
    (abort "SetCmd has only been tested on OS 3.1.4 and up, so not installing on this OS!")
  )
)
; OS 3
(if (and (>= (/ (getversion) 65536) 40) (< (/ (getversion) 65536) 50))
  (
    (set #os-desc "amigaos3-68k")
  )
)
; OS 4
(if (>= (/ (getversion) 65536) 50)
  (
    (set #os-desc "amigaos4-ppc")
  )
)

(message 
  "Welcome to the SetCmd " #setcmd-version " Installer!\n"
  "This will install the SetCmd utility and documentation on your system.\n\n"
  "NOTE: It will not automatically initialise SetCmd for you, for information on how to do this, "
  "please make sure you read the included documentation.\n"
)

(welcome)
(procedure get_and_create_destination
  (
    (set #dname
      (askdir
        (prompt (cat "Choose destination directory.\n"
          "A drawer called SetCmd will be created." ))
        (help @askdir-help)
        (default "Work:")
      )
    )
    (set #dname (tackon #dname "SetCmd"))
    ; This is the built-in variable that gets displayed to the user at the end of the installation
    (set @default-dest #dname)

    (makedir #dname
      (prompt ("Create drawer %s?" #dname))
      (help @makedir-help)
      (safe)
    )
    (makedir (tackon #dname "support"))
    
    (makeassign "SETCMD" #dname (safe))
    (set #new_install 1)
  )
)


(get_and_create_destination)
(set #dname (getassign "SETCMD" "a"))

; Set these variables as they're useful later and avoid excessive nested tackons!
(set #path-dir (tackon #dname "path"))
(set #cmd-dir (tackon #dname "cmds"))
(set #setcmd-cmd-dir (tackon #cmd-dir "setcmd"))
(set #setcmd-full-path (tackon #setcmd-cmd-dir (cat #setcmd-version "-" #os-desc)))

; Set up the link database directory structure
(makedir #path-dir)
(makedir #cmd-dir)
(makedir #setcmd-cmd-dir)

; Binary full names
(set #amigaos3 "-amigaos3-68k")
(set #amigaos4 "-amigaos4-ppc")
(set #setcmd-amigaos3-binary (cat "setcmd-" #setcmd-version #amigaos3))
(set #stub-amigaos3-binary (cat "stub-" #setcmd-version #amigaos3))
(set #setcmd-amigaos4-binary (cat "setcmd-" #setcmd-version #amigaos4))
(set #stub-amigaos4-binary (cat "stub-" #setcmd-version #amigaos4))
(set #stub-native (cat "stub-" #setcmd-version "-" #os-desc))

; Copy AmigaOS 3 binary for all platforms
(copyfiles
  (source #setcmd-amigaos3-binary)
  (dest #setcmd-cmd-dir)
  (newname (cat #setcmd-version #amigaos3))
  (prompt ("Copy SetCmd AmigaOS 3.x program file?"))
  (confirm "expert")
  (all)
  (help @copyfiles-help)
)

; Only copy the relevant stub 
(copyfiles
  (source #stub-native)
  (dest #dname)
  (newname "stub")
  (prompt ("Copy SetCmd stub file?"))
  (confirm "expert")
  (all)
  (help @copyfiles-help)
)

